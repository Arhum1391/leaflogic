# Local dev config for `run.ps1`. Copy this file to `dev.env` and fill in
# real values. `dev.env` is gitignored - never commit real secrets.
#
# Format: KEY=VALUE per line. # starts a comment. No quotes around values.

# --- Supabase (compiled into the app via --dart-define) ---
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=eyJ...your-anon-key-here...

# --- Google Sign-In (compiled into the app via --dart-define) ---
# This is the SAME OAuth 2.0 Client ID (type "Web application") that you
# configured in Supabase Dashboard -> Auth -> Providers -> Google. The
# Android Google Sign-In SDK uses it as serverClientId so the returned
# ID token is signed for an audience Supabase will accept.
#
# In addition, you must create a second OAuth 2.0 Client ID of type
# "Android" in Google Cloud Console with:
#   - Package name: com.leaflogic.leaflogic
#   - SHA-1: from `cd android && .\gradlew signingReport` (look at the
#     "debug" variant SHA-1 line). Add the release SHA-1 too if you ship
#     a real APK.
# Without the Android client, Google Play Services rejects the sign-in
# request even if GOOGLE_WEB_CLIENT_ID is correct.
GOOGLE_WEB_CLIENT_ID=xxxxx.apps.googleusercontent.com

# --- Shell env (consumed by flutter / gradle, not by the app) ---
# Uncomment to relocate the pub cache to D:\ so Kotlin's incremental compiler
# stops crashing on cross-drive paths. After uncommenting, run.ps1 will set
# PUB_CACHE for the session, and the next `flutter pub get` will re-download
# all packages into D:\pub-cache (~5 min one-time). Once that's done, you can
# also flip `kotlin.incremental=false` back to `true` in
# android/gradle.properties for faster incremental builds.
# PUB_CACHE=D:\pub-cache
